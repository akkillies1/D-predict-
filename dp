#!/usr/bin/env bash
set -Eeuo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DB_DIR="$ROOT_DIR/db"; ENGINE_DIR="$ROOT_DIR/engine"; COLLECTOR_DIR="$ROOT_DIR/collector"; BACKEND_DIR="$ROOT_DIR/backend"; ENV_FILE="$ROOT_DIR/.env"; RUN_DIR="$ROOT_DIR/.run"
info(){ printf '\033[1;32m[d-predict]\033[0m %s\n' "$*"; }
warn(){ printf '\033[1;33m[d-predict]\033[0m %s\n' "$*" >&2; }
die(){ printf '\033[1;31m[d-predict]\033[0m %s\n' "$*" >&2; exit 1; }
ensure_env(){ if [[ ! -f "$ENV_FILE" ]]; then cp "$ROOT_DIR/.env.example" "$ENV_FILE"; info "Created .env from .env.example"; fi; }
load_env(){ [[ -f "$ENV_FILE" ]] && set -a && source "$ENV_FILE" && set +a; }
check_command(){ command -v "$1" >/dev/null 2>&1 || die "Missing '$1'. Run './dp doctor' for guidance."; }
setup_python(){ check_command python3; [[ -d "$COLLECTOR_DIR/.venv" ]] || python3 -m venv "$COLLECTOR_DIR/.venv"; source "$COLLECTOR_DIR/.venv/bin/activate"; python -m pip install --upgrade pip >/dev/null; python -m pip install -r "$COLLECTOR_DIR/requirements.txt"; }
setup_node(){ check_command node; check_command npm; (cd "$ENGINE_DIR" && npm ci); }
setup_backend(){ check_command node; check_command npm; (cd "$BACKEND_DIR" && npm install); }
setup_database(){ for c in initdb pg_ctl psql createdb pg_isready; do check_command "$c"; done; load_env; NIFTY_DB_PORT="${NIFTY_DB_PORT:-5433}" "$DB_DIR/setup.sh"; }
cmd_init(){ ensure_env; setup_python; setup_node; setup_backend; setup_database; info "Initialization complete. Run './dp doctor' then './dp start'."; }
cmd_doctor(){ local failed=0 c; for c in python3 node npm; do if command -v "$c" >/dev/null 2>&1; then info "$c: available"; else warn "$c: missing"; failed=1; fi; done; for c in initdb pg_ctl psql createdb pg_isready; do if command -v "$c" >/dev/null 2>&1; then info "$c: available"; else warn "$c: missing (local DB)"; failed=1; fi; done; [[ -f "$ENV_FILE" ]] && info ".env: present" || warn ".env: missing"; [[ -d "$DB_DIR/data" ]] && info "database cluster: initialized" || warn "database cluster: not initialized"; [[ -d "$ENGINE_DIR/node_modules" ]] && info "node dependencies: installed" || warn "node dependencies: missing"; [[ -d "$COLLECTOR_DIR/.venv" ]] && info "python environment: installed" || warn "python environment: missing"; if [[ -f "$DB_DIR/data/PG_VERSION" ]]; then load_env; if pg_isready -h localhost -p "${NIFTY_DB_PORT:-5433}" >/dev/null 2>&1; then info "database: running"; else info "database: stopped"; fi; fi; return "$failed"; }
cmd_start(){ ensure_env; load_env; [[ -d "$DB_DIR/data" ]] || cmd_init; NIFTY_DB_PORT="${NIFTY_DB_PORT:-5433}" "$DB_DIR/start.sh"; mkdir -p "$RUN_DIR"; if [[ -d "$BACKEND_DIR/node_modules" ]]; then (cd "$ROOT_DIR" && nohup npm --prefix "$BACKEND_DIR" run dev > "$RUN_DIR/api.log" 2>&1 & echo $! > "$RUN_DIR/api.pid"); info "Local API started at http://127.0.0.1:${API_PORT:-4100}"; else warn "Backend dependencies missing; run './dp init'."; fi; info "Database started. Run './dp collect' separately when ready."; }
cmd_stop(){ if [[ -f "$RUN_DIR/api.pid" ]] && kill -0 "$(cat "$RUN_DIR/api.pid")" 2>/dev/null; then kill "$(cat "$RUN_DIR/api.pid")" || true; fi; "$DB_DIR/stop.sh" || true; info "Local API and database stopped."; }
cmd_collect(){ ensure_env; setup_python; (cd "$ROOT_DIR" && source "$COLLECTOR_DIR/.venv/bin/activate" && python -m collector.main); }
cmd_engine(){ ensure_env; setup_node; (cd "$ENGINE_DIR" && npm run "$1"); }
cmd_test(){ setup_node; setup_backend; (cd "$ENGINE_DIR" && npm test && npm run build); (cd "$BACKEND_DIR" && npm test); }
cmd_update(){ check_command git; git -C "$ROOT_DIR" pull --ff-only; cmd_init; }
usage(){ cat <<'HELP'
D-predict local command
Usage: ./dp <command>
  init       Install dependencies, create .env, initialize local PostgreSQL
  doctor     Check runtimes, dependencies, database, and configuration
  start      Start local PostgreSQL and API
  stop       Stop local PostgreSQL and API
  api        Run the local API in the foreground
  collect    Run the Python collector continuously
  test       Run engine tests and TypeScript build
  features   Run feature generation
  signal     Run signal generation
  construct  Run trade construction
  backtest   Run signal backtest
  forecast   Run Monte Carlo forecast
  update     Pull Git changes and re-run initialization
HELP
}
case "${1:-help}" in
  init) cmd_init ;; doctor) cmd_doctor ;; start) cmd_start ;; stop) cmd_stop ;; api) ensure_env; load_env; (cd "$BACKEND_DIR" && npm run dev) ;; collect) cmd_collect ;; test) cmd_test ;; features|signal|construct|backtest|forecast) cmd_engine "$1" ;; update) cmd_update ;; help|-h|--help) usage ;; *) usage; die "Unknown command: $1";;
esac
